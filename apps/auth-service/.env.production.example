PORT=4001
NODE_ENV=production
ENABLE_DOCS=false
GIT_SHA=<git-sha>
BASE_URL=https://api.betterbasket.app
DATABASE_URL=postgresql://<runtime-role>:<password>@<neon-prod-branch-host>-pooler.neon.tech/<db>?sslmode=require
DIRECT_DATABASE_URL=postgresql://<migrator-role>:<password>@<neon-prod-branch-host>.neon.tech/<db>?sslmode=require
BETTER_AUTH_SECRET=<placeholder-generate-a-32-byte-secret>
TRUSTED_ORIGINS=https://betterbasket.app,https://sell.betterbasket.app,https://admin.betterbasket.app
WEB_URL=https://betterbasket.app
RESEND_API_KEY=<placeholder-resend-api-key>
EMAIL_FROM=BetterBasket <no-reply@betterbasket.app>
EMAIL_ALLOWED_RECIPIENTS=
