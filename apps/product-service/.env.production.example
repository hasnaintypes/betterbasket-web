# Replace placeholders with managed service credentials before starting.
PORT=4002
NODE_ENV=production
AUTH_ISSUER=https://api.betterbasket.app
AUTH_AUDIENCE=https://api.betterbasket.app
AUTH_JWKS_URL=https://auth.internal.betterbasket.app/api/auth/jwks
MONGODB_URI=mongodb+srv://<user>:<password>@<prod-cluster>.mongodb.net/betterbasket_products?retryWrites=true&w=majority
KAFKA_BROKERS=<prod-cluster-id>.<region>.cloud.redpanda.com:9092
KAFKA_USERNAME=<redpanda-cloud-username>
KAFKA_PASSWORD=<redpanda-cloud-password>
KAFKA_TOPIC_PREFIX=
