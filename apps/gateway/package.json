{
  "name": "gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Single entry point for all client apps. Verifies JWTs, proxies to downstream services, rate-limits.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "jest && pnpm build && node --test test/*.test.mjs",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@betterbasket/auth-shared": "workspace:*",
    "@betterbasket/contracts": "workspace:*",
    "@betterbasket/logger": "workspace:*",
    "@betterbasket/runtime": "workspace:*",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "http-proxy-middleware": "^3.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@betterbasket/config": "workspace:*",
    "@betterbasket/test-utils": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.3",
    "@swc/core": "^1.16.21",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
