{
  "name": "gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Single entry point for all client apps. Verifies JWTs, proxies to downstream services, rate-limits.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/swagger": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "http-proxy-middleware": "^3.0.3",
    "@nestjs/throttler": "^6.5.0",
    "@betterbasket/auth-shared": "workspace:*",
    "@betterbasket/contracts": "workspace:*",
    "@betterbasket/logger": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@betterbasket/config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3"
  }
}
