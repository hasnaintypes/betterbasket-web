# Replace placeholders with managed service credentials before starting.
PORT=4004
NODE_ENV=development
AUTH_ISSUER=http://localhost:4000
AUTH_AUDIENCE=http://localhost:4000
AUTH_JWKS_URL=http://localhost:4001/api/auth/jwks
# Pooled runtime URL (-pooler host), using the app role without DDL rights.
DATABASE_URL=postgresql://<runtime-role>:<password>@<neon-dev-branch-host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# Direct URL (no -pooler), using the separate migrator role.
DIRECT_DATABASE_URL=postgresql://<migrator-role>:<password>@<neon-dev-branch-host>.<region>.aws.neon.tech/<db>?sslmode=require
PRODUCT_SERVICE_URL=http://localhost:4002
KAFKA_BROKERS=<dev-cluster-id>.<region>.cloud.redpanda.com:9092
KAFKA_USERNAME=<redpanda-cloud-username>
KAFKA_PASSWORD=<redpanda-cloud-password>
KAFKA_TOPIC_PREFIX=dev.
