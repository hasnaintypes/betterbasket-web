{
  "name": "payment-service",
  "version": "0.1.0",
  "private": true,
  "description": "Stripe Connect payment intents, webhooks, seller payout ledger. Postgres-backed.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/swagger": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "pg": "^8.13.0",
    "drizzle-orm": "^0.45.2",
    "stripe": "^22.6.1",
    "@betterbasket/auth-shared": "workspace:*",
    "@betterbasket/contracts": "workspace:*",
    "@betterbasket/kafka-client": "workspace:*",
    "@betterbasket/logger": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@betterbasket/config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3",
    "eslint": "^9.12.0"
  }
}
