# Replace placeholders with approved test-mode credentials until the live-payments gate opens.
PORT=4005
NODE_ENV=production
AUTH_ISSUER=https://api.betterbasket.app
AUTH_AUDIENCE=https://api.betterbasket.app
AUTH_JWKS_URL=https://auth.internal.betterbasket.app/api/auth/jwks
DATABASE_URL=postgresql://<user>:<password>@<neon-prod-branch-host>.neon.tech/<db>?sslmode=require
# Direct URL for the separate migration role; never use it as the runtime URL.
DIRECT_DATABASE_URL=postgresql://<migrator-role>:<password>@<neon-prod-branch-host>.neon.tech/<db>?sslmode=require
STRIPE_SECRET_KEY=sk_test_...
STRIPE_ACCOUNT_WEBHOOK_SECRET=whsec_account_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connect_...
PAYMENTS_LIVE_MODE_ENABLED=false
PLATFORM_FEE_BPS=1000
KAFKA_BROKERS=<prod-cluster-id>.<region>.cloud.redpanda.com:9092
KAFKA_USERNAME=<redpanda-cloud-username>
KAFKA_PASSWORD=<redpanda-cloud-password>
KAFKA_TOPIC_PREFIX=
