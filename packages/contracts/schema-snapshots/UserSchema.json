{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "banned": {
      "default": false,
      "type": "boolean"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "email": {
      "format": "email",
      "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
    },
    "emailVerified": {
      "default": false,
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "image": {
      "anyOf": [
        {
          "format": "uri",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "role": {
      "default": "customer",
      "enum": [
        "admin",
        "customer",
        "seller"
      ],
      "type": "string"
    }
  },
  "required": [
    "createdAt",
    "email",
    "id",
    "name"
  ],
  "type": "object"
}
