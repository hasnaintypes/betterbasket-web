{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "buyerId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "expiresAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "orderId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "awaiting_payment",
        "cancelled",
        "fulfilled",
        "in_fulfilment",
        "paid"
      ],
      "type": "string"
    },
    "subOrders": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "sellerId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "total": {
            "properties": {
              "amount": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "currency": {
                "default": "USD",
                "maxLength": 3,
                "minLength": 3,
                "type": "string"
              }
            },
            "required": [
              "amount"
            ],
            "type": "object"
          }
        },
        "required": [
          "id",
          "sellerId",
          "total"
        ],
        "type": "object"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array"
    },
    "total": {
      "properties": {
        "amount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "currency": {
          "default": "USD",
          "maxLength": 3,
          "minLength": 3,
          "type": "string"
        }
      },
      "required": [
        "amount"
      ],
      "type": "object"
    }
  },
  "required": [
    "buyerId",
    "expiresAt",
    "orderId",
    "status",
    "subOrders",
    "total"
  ],
  "type": "object"
}
