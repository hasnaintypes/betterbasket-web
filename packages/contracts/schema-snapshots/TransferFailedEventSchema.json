{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "aggregateId": {
      "minLength": 1,
      "type": "string"
    },
    "aggregateType": {
      "minLength": 1,
      "type": "string"
    },
    "aggregateVersion": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "causationId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "correlationId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "occurredAt": {
      "format": "date-time",
      "type": "string"
    },
    "payload": {
      "properties": {
        "amount": {
          "properties": {
            "amount": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "currency": {
              "default": "USD",
              "maxLength": 3,
              "minLength": 3,
              "type": "string"
            }
          },
          "required": [
            "amount"
          ],
          "type": "object"
        },
        "reason": {
          "type": "string"
        },
        "sellerId": {
          "minLength": 1,
          "type": "string"
        },
        "subOrderId": {
          "minLength": 1,
          "type": "string"
        },
        "transferId": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "amount",
        "sellerId",
        "subOrderId",
        "transferId"
      ],
      "type": "object"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "traceparent": {
      "type": "string"
    },
    "type": {
      "const": "transfer.failed",
      "type": "string"
    },
    "version": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "aggregateId",
    "aggregateType",
    "causationId",
    "correlationId",
    "id",
    "occurredAt",
    "payload",
    "producer",
    "type",
    "version"
  ],
  "type": "object"
}
