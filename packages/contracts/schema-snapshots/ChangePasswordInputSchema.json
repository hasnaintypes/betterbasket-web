{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confirmPassword": {
      "type": "string"
    },
    "currentPassword": {
      "minLength": 1,
      "type": "string"
    },
    "newPassword": {
      "maxLength": 128,
      "minLength": 12,
      "type": "string"
    }
  },
  "required": [
    "confirmPassword",
    "currentPassword",
    "newPassword"
  ],
  "type": "object"
}
