{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "aggregateId": {
      "minLength": 1,
      "type": "string"
    },
    "aggregateType": {
      "minLength": 1,
      "type": "string"
    },
    "aggregateVersion": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "causationId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "correlationId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "occurredAt": {
      "format": "date-time",
      "type": "string"
    },
    "payload": {
      "properties": {
        "chargesEnabled": {
          "type": "boolean"
        },
        "country": {
          "maxLength": 2,
          "minLength": 2,
          "type": "string"
        },
        "payoutsEnabled": {
          "type": "boolean"
        },
        "requirementsDue": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "type": "array"
        },
        "stripeAccountId": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "chargesEnabled",
        "country",
        "payoutsEnabled",
        "requirementsDue",
        "stripeAccountId"
      ],
      "type": "object"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "traceparent": {
      "type": "string"
    },
    "type": {
      "const": "stripe.account-updated",
      "type": "string"
    },
    "version": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "aggregateId",
    "aggregateType",
    "causationId",
    "correlationId",
    "id",
    "occurredAt",
    "payload",
    "producer",
    "type",
    "version"
  ],
  "type": "object"
}
