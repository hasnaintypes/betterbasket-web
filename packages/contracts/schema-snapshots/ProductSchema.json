              "type": "string"
            },
            "type": "object"
          },
          "price": {
            "properties": {
              "amount": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "currency": {
                "default": "USD",
                "maxLength": 3,
                "minLength": 3,
                "type": "string"
              }
            },
            "required": [
              "amount"
            ],
            "type": "object"
          },
          "sku": {
            "type": "string"
          },
          "stock": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "price",
          "sku",
          "stock"
        ],
        "type": "object"
      },
      "type": "array"
