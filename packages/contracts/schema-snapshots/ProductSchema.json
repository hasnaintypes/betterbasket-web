{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "basePrice": {
      "properties": {
        "amount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "currency": {
          "const": "USD",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "type": "object"
    },
    "category": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 5000,
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "images": {
      "default": [],
      "items": {
        "format": "uri",
        "maxLength": 2048,
        "type": "string"
      },
      "maxItems": 12,
      "type": "array"
    },
    "sellerId": {
      "type": "string"
    },
    "sellerStatus": {
      "default": "other",
      "enum": [
        "active",
        "other",
        "suspended"
      ],
      "type": "string"
    },
    "slug": {
      "maxLength": 220,
      "minLength": 2,
      "type": "string"
    },
    "status": {
      "default": "draft",
      "enum": [
        "active",
        "archived",
        "draft",
        "unpublished"
      ],
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 2,
      "type": "string"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "variants": {
      "default": [],
      "items": {
        "properties": {
          "options": {
            "additionalProperties": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            "default": {},
            "propertyNames": {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            "type": "object"
          },
          "price": {
            "properties": {
              "amount": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "currency": {
                "const": "USD",
                "type": "string"
              }
            },
            "required": [
              "amount",
              "currency"
            ],
            "type": "object"
          },
          "sku": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "stock": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "variantId": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          }
        },
        "required": [
          "price",
          "sku",
          "stock",
          "variantId"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "type": "array"
    },
    "version": {
      "default": 0,
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "basePrice",
    "category",
    "createdAt",
    "id",
    "sellerId",
    "slug",
    "title",
    "updatedAt"
  ],
  "type": "object"
}
