{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "buyerId": {
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "items": {
      "items": {
        "properties": {
          "productId": {
            "type": "string"
          },
          "quantity": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "sellerId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "unitPrice": {
            "properties": {
              "amount": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "currency": {
                "default": "USD",
                "maxLength": 3,
                "minLength": 3,
                "type": "string"
              }
            },
            "required": [
              "amount"
            ],
            "type": "object"
          },
          "variantId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "productId",
          "quantity",
          "sellerId",
          "title",
          "unitPrice"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "shippingTotal": {
      "properties": {
        "amount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "currency": {
          "default": "USD",
          "maxLength": 3,
          "minLength": 3,
          "type": "string"
        }
      },
      "required": [
        "amount"
      ],
      "type": "object"
    },
    "status": {
      "default": "pending",
      "enum": [
        "awaiting_payment",
        "cancelled",
        "delivered",
        "fulfilling",
        "paid",
        "pending",
        "refunded",
        "shipped"
      ],
      "type": "string"
    },
    "stripePaymentIntentId": {
      "type": [
        "string",
        "null"
      ]
    },
    "subtotal": {
      "properties": {
        "amount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "currency": {
          "default": "USD",
          "maxLength": 3,
          "minLength": 3,
          "type": "string"
        }
      },
      "required": [
        "amount"
      ],
      "type": "object"
    },
    "total": {
      "properties": {
        "amount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "currency": {
          "default": "USD",
          "maxLength": 3,
          "minLength": 3,
          "type": "string"
        }
      },
      "required": [
        "amount"
      ],
      "type": "object"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "buyerId",
    "createdAt",
    "id",
    "items",
    "shippingTotal",
    "subtotal",
    "total",
    "updatedAt"
  ],
  "type": "object"
}
