{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "aud": {
      "type": "string"
    },
    "email": {
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
    },
    "emailVerified": {
      "type": "boolean"
    },
    "exp": {
      "type": "number"
    },
    "iat": {
      "type": "number"
    },
    "iss": {
      "type": "string"
    },
    "jti": {
      "type": "string"
    },
    "orgId": {
      "type": [
        "string",
        "null"
      ]
    },
    "orgRole": {
      "anyOf": [
        {
          "enum": [
            "admin",
            "member",
            "owner"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "platformRole": {
      "enum": [
        "admin",
        "customer"
      ],
      "type": "string"
    },
    "sub": {
      "type": "string"
    }
  },
  "required": [
    "aud",
    "email",
    "emailVerified",
    "exp",
    "iat",
    "iss",
    "jti",
    "orgId",
    "orgRole",
    "platformRole",
    "sub"
  ],
  "type": "object"
}
