{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "productId": {
      "type": "string"
    },
    "quantity": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "sellerId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "unitPrice": {
      "properties": {
        "amount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "currency": {
          "default": "USD",
          "maxLength": 3,
          "minLength": 3,
          "type": "string"
        }
      },
      "required": [
        "amount"
      ],
      "type": "object"
    },
    "variantId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "productId",
    "quantity",
    "sellerId",
    "title",
    "unitPrice"
  ],
  "type": "object"
}
