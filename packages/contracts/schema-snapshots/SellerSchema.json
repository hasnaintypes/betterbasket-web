{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string"
    },
    "logoUrl": {
      "anyOf": [
        {
          "format": "uri",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "organizationId": {
      "type": "string"
    },
    "slug": {
      "maxLength": 100,
      "minLength": 2,
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "active",
        "pending",
        "stripe_pending",
        "suspended"
      ],
      "type": "string"
    },
    "storeName": {
      "maxLength": 100,
      "minLength": 2,
      "type": "string"
    },
    "stripeAccountId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "createdAt",
    "id",
    "organizationId",
    "slug",
    "storeName"
  ],
  "type": "object"
}
