{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confirmPassword": {
      "type": "string"
    },
    "email": {
      "format": "email",
      "maxLength": 320,
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "password": {
      "maxLength": 128,
      "minLength": 12,
      "type": "string"
    }
  },
  "required": [
    "confirmPassword",
    "email",
    "name",
    "password"
  ],
  "type": "object"
}
