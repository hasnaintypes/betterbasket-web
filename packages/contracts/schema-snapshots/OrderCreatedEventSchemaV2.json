{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "aggregateId": {
      "minLength": 1,
      "type": "string"
    },
    "aggregateType": {
      "minLength": 1,
      "type": "string"
    },
    "aggregateVersion": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "causationId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "correlationId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "occurredAt": {
      "format": "date-time",
      "type": "string"
    },
    "payload": {
      "properties": {
        "buyerId": {
          "minLength": 1,
          "type": "string"
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "orderId": {
          "minLength": 1,
          "type": "string"
        },
        "sellerIds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array"
        },
        "subOrders": {
          "items": {
            "properties": {
              "commission": {
                "properties": {
                  "amount": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "currency": {
                    "default": "USD",
                    "maxLength": 3,
                    "minLength": 3,
                    "type": "string"
                  }
                },
                "required": [
                  "amount"
                ],
                "type": "object"
              },
              "gross": {
                "properties": {
                  "amount": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "currency": {
                    "default": "USD",
                    "maxLength": 3,
                    "minLength": 3,
                    "type": "string"
                  }
                },
                "required": [
                  "amount"
                ],
                "type": "object"
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "net": {
                "properties": {
                  "amount": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "currency": {
                    "default": "USD",
                    "maxLength": 3,
                    "minLength": 3,
                    "type": "string"
                  }
                },
                "required": [
                  "amount"
                ],
                "type": "object"
              },
              "sellerId": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "commission",
              "gross",
              "id",
              "net",
              "sellerId"
            ],
            "type": "object"
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array"
        },
        "total": {
          "properties": {
            "amount": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "currency": {
              "default": "USD",
              "maxLength": 3,
              "minLength": 3,
              "type": "string"
            }
          },
          "required": [
            "amount"
          ],
          "type": "object"
        }
      },
      "required": [
        "buyerId",
        "expiresAt",
        "orderId",
        "sellerIds",
        "subOrders",
        "total"
      ],
      "type": "object"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "traceparent": {
      "type": "string"
    },
    "type": {
      "const": "order.created",
      "type": "string"
    },
    "version": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "aggregateId",
    "aggregateType",
    "causationId",
    "correlationId",
    "id",
    "occurredAt",
    "payload",
    "producer",
    "type",
    "version"
  ],
  "type": "object"
}
