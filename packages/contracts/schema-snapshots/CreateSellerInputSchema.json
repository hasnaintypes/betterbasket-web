{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "country": {
      "pattern": "^[A-Z]{2}$",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "slug": {
      "maxLength": 100,
      "minLength": 2,
      "type": "string"
    },
    "storeName": {
      "maxLength": 100,
      "minLength": 2,
      "type": "string"
    },
    "supportEmail": {
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
    }
  },
  "required": [
    "country",
    "slug",
    "storeName",
    "supportEmail"
  ],
  "type": "object"
}
