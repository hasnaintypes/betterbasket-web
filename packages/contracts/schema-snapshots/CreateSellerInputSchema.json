{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "description": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "slug": {
      "maxLength": 100,
      "minLength": 2,
      "type": "string"
    },
    "storeName": {
      "maxLength": 100,
      "minLength": 2,
      "type": "string"
    }
  },
  "required": [
    "slug",
    "storeName"
  ],
  "type": "object"
}
