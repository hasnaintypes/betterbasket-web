{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "basePrice": {
      "properties": {
        "amount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "currency": {
          "const": "USD",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "type": "object"
    },
    "category": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 5000,
      "type": "string"
    },
    "images": {
      "default": [],
      "items": {
        "format": "uri",
        "maxLength": 2048,
        "type": "string"
      },
      "maxItems": 12,
      "type": "array"
    },
    "title": {
      "maxLength": 200,
      "minLength": 2,
      "type": "string"
    },
    "variants": {
      "default": [],
      "items": {
        "properties": {
          "options": {
            "additionalProperties": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            "default": {},
            "propertyNames": {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            "type": "object"
          },
          "price": {
            "properties": {
              "amount": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "currency": {
                "const": "USD",
                "type": "string"
              }
            },
            "required": [
              "amount",
              "currency"
            ],
            "type": "object"
          },
          "sku": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "stock": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "price",
          "sku",
          "stock"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "type": "array"
    }
  },
  "required": [
    "basePrice",
    "category",
    "title"
  ],
  "type": "object"
}
