{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "aggregateId": {
      "minLength": 1,
      "type": "string"
    },
    "aggregateType": {
      "minLength": 1,
      "type": "string"
    },
    "aggregateVersion": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "causationId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "correlationId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "occurredAt": {
      "format": "date-time",
      "type": "string"
    },
    "payload": {
      "properties": {
        "bannedAt": {
          "format": "date-time",
          "type": "string"
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "userId": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "bannedAt",
        "reason",
        "userId"
      ],
      "type": "object"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "traceparent": {
      "type": "string"
    },
    "type": {
      "const": "user.banned",
      "type": "string"
    },
    "version": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "aggregateId",
    "aggregateType",
    "causationId",
    "correlationId",
    "id",
    "occurredAt",
    "payload",
    "producer",
    "type",
    "version"
  ],
  "type": "object"
}
