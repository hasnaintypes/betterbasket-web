{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "lines": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "lineId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "productId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "quantity": {
            "maximum": 99,
            "minimum": 1,
            "type": "integer"
          },
          "variantId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "lineId",
          "productId",
          "quantity",
          "variantId"
        ],
        "type": "object"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array"
    },
    "orderId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "lines",
    "orderId"
  ],
  "type": "object"
}
