{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "lineId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "lineTotal": {
            "properties": {
              "amount": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "currency": {
                "default": "USD",
                "maxLength": 3,
                "minLength": 3,
                "type": "string"
              }
            },
            "required": [
              "amount"
            ],
            "type": "object"
          },
          "productId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "quantity": {
            "maximum": 99,
            "minimum": 1,
            "type": "integer"
          },
          "sellerId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "sku": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "titleSnapshot": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "unitPrice": {
            "properties": {
              "amount": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "currency": {
                "default": "USD",
                "maxLength": 3,
                "minLength": 3,
                "type": "string"
              }
            },
            "required": [
              "amount"
            ],
            "type": "object"
          },
          "variantId": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "lineId",
          "lineTotal",
          "productId",
          "quantity",
          "sellerId",
          "sku",
          "titleSnapshot",
          "unitPrice"
        ],
        "type": "object"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array"
    },
    "orderId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "sellerId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "shippingTotal": {
      "properties": {
        "amount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "currency": {
          "default": "USD",
          "maxLength": 3,
          "minLength": 3,
          "type": "string"
        }
      },
      "required": [
        "amount"
      ],
      "type": "object"
    },
    "status": {
      "enum": [
        "awaiting_payment",
        "cancelled",
        "confirmed",
        "delivered",
        "paid",
        "shipped"
      ],
      "type": "string"
    },
    "subtotal": {
      "properties": {
        "amount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "currency": {
          "default": "USD",
          "maxLength": 3,
          "minLength": 3,
          "type": "string"
        }
      },
      "required": [
        "amount"
      ],
      "type": "object"
    },
    "total": {
      "properties": {
        "amount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "currency": {
          "default": "USD",
          "maxLength": 3,
          "minLength": 3,
          "type": "string"
        }
      },
      "required": [
        "amount"
      ],
      "type": "object"
    },
    "updatedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    }
  },
  "required": [
    "createdAt",
    "id",
    "items",
    "orderId",
    "sellerId",
    "shippingTotal",
    "status",
    "subtotal",
    "total",
    "updatedAt"
  ],
  "type": "object"
}
