{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "occurredAt": {
      "format": "date-time",
      "type": "string"
    },
    "payload": {
      "properties": {
        "newStatus": {
          "enum": [
            "awaiting_payment",
            "cancelled",
            "delivered",
            "fulfilling",
            "paid",
            "pending",
            "refunded",
            "shipped"
          ],
          "type": "string"
        },
        "orderId": {
          "type": "string"
        },
        "previousStatus": {
          "enum": [
            "awaiting_payment",
            "cancelled",
            "delivered",
            "fulfilling",
            "paid",
            "pending",
            "refunded",
            "shipped"
          ],
          "type": "string"
        }
      },
      "required": [
        "newStatus",
        "orderId",
        "previousStatus"
      ],
      "type": "object"
    },
    "producer": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "occurredAt",
    "payload",
    "producer"
  ],
  "type": "object"
}
