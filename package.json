{
  "name": "betterbasket-ecommerce",
  "private": true,
  "version": "0.1.0",
  "description": "BetterBasket - multi-tenant e-commerce marketplace monorepo (Turborepo)",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "check:md-links": "node .github/scripts/check-md-links.mjs",
    "test:scripts": "node --test .github/scripts/*.test.mjs"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@scarf/scarf"
    ],
    "overrides": {
      "test-exclude": "^8.0.0",
      "esbuild@<=0.24.2": ">=0.25.0",
      "postcss@<8.5.10": ">=8.5.10",
      "postcss@<=8.5.11": ">=8.5.12",
      "postcss@<=8.5.22": ">=8.5.23",
      "postcss@<=8.5.17": ">=8.5.18",
      "js-yaml@>=5.0.0 <=5.4.0": ">=5.4.1",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2",
      "proxy-addr@>=1.1.0 <2.0.8": ">=2.0.8",
      "follow-redirects@>=1.16.0 <1.16.1": ">=1.16.1",
      "body-parser@>=2.0.0 <2.4.0": ">=2.4.0",
      "multer@>=2.0.0 <2.5.0": ">=2.5.0",
      "qs@>=6.7.0 <=6.16.0": ">=6.16.1",
      "follow-redirects@>=1.16.0 <=1.16.1": ">=1.16.2"
    }
  }
}
